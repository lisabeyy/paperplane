# Postgres from the Railway plugin. Leave empty to run an in-memory board locally.
DATABASE_URL=

# SOL already paid to pilots. Receipts stay at 0 until a season is settled.
PRESS_SOL_PAID=0

# Lifetime creator fees claimed, in SOL. Leave empty until the first claim.
PRESS_SOL_COLLECTED=

# Public creator wallet. Its SOL balance is read live for the press.
PRESS_WALLET=

# pump.fun mint. When set, the app reads balances and links to the coin.
PLANE_MINT=

# Optional. Defaults to the public Solana mainnet endpoint.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
